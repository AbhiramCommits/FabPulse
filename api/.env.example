# FabPulse backend configuration (copy to api/.env or export in your shell).
#
# Primary warehouse. When unset, FabPulse probes localhost:5432/fabpulse and
# falls back to data/fabpulse.db (SQLite) if no Postgres server is reachable.
FABPULSE_DATABASE_URL=postgresql+psycopg://localhost:5432/fabpulse

# Postgres server probed when FABPULSE_DATABASE_URL is unset.
FABPULSE_POSTGRES_URL=postgresql+psycopg://localhost:5432/fabpulse

# Comma-separated CORS origins allowed to call the API from the browser.
FABPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend environment variable (set in web/.env.local when the API is remote):
# VITE_API_BASE=http://127.0.0.1:8000
